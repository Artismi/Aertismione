# ─────────────────────────────────────────
# ARTISMI — Variabili d'Ambiente Locali
# Copiare questo file in .env.local e
# riempire i valori reali — NON committare .env.local!
# ─────────────────────────────────────────

# Notion Integration Secret
# Ottieni da: https://www.notion.so/my-integrations
NOTION_TOKEN=secret_XXXXXXXXXXXXXXXX

# Notion Database IDs
# Aprire il database Notion nel browser —
# l'ID è la stringa nella URL prima del "?"
NOTION_DB_PORTFOLIO=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
NOTION_DB_SERVIZI=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
NOTION_DB_TESTI=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
